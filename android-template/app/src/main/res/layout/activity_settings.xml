<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="الإعدادات والأذونات"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#111111"
            android:layout_marginBottom="6dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="فعّل أو عطّل أذونات التطبيق بدقة. النظام قد يطلب تأكيدك في أول استخدام."
            android:textSize="13sp"
            android:textColor="#666666"
            android:layout_marginBottom="20dp" />

        <Switch android:id="@+id/switch_camera"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="الكاميرا" android:textSize="16sp" android:padding="12dp" />

        <Switch android:id="@+id/switch_mic"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="الميكروفون" android:textSize="16sp" android:padding="12dp" />

        <Switch android:id="@+id/switch_location"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="الموقع الجغرافي" android:textSize="16sp" android:padding="12dp" />

        <Switch android:id="@+id/switch_notifications"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="الإشعارات" android:textSize="16sp" android:padding="12dp" />

        <Switch android:id="@+id/switch_storage"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="الوسائط والملفات" android:textSize="16sp" android:padding="12dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#EEEEEE"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/open_system_settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="فتح إعدادات النظام للتطبيق"
            android:backgroundTint="APP_COLOR"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/close_settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="رجوع"
            android:background="@android:color/transparent"
            android:textColor="#555555"
            android:layout_marginTop="8dp" />
    </LinearLayout>
</ScrollView>
